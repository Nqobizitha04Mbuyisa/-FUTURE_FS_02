# ============================================
#  Mini CRM - Backend Environment Variables
# ============================================
# Copy this file to .env in /crm-backend and fill in real values.
# spring-dotenv is included so ${VAR} placeholders in
# application.properties will resolve from this file at startup.

# ---- Server ----
SERVER_PORT=8080

# ---- SQL Server ----
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=mini_crm;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=YourStrong!Passw0rd

# ---- JWT ----
# Use any base64-encoded random 32+ byte string in production
JWT_SECRET=ZmQ4MjE3MDM0YzVlMDljYmQwYzQ1OWY3ZjgyMzY1MmE1Y2VkMTQzMmM3OWFhMmRlOTMxNGY1NzdmMzM5MDIzZQ==
JWT_EXPIRATION_MS=86400000

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Default Admin (seeded on first run) ----
ADMIN_EMAIL=admin@crm.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Administrator
